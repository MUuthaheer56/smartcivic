# SmartCivic Environment Configuration
# Copy this to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-long-random-string-min-32-chars
JWT_SECRET=change-this-to-another-long-random-string-min-32-chars

# MongoDB
MONGO_URI=mongodb://localhost:27017/
DB_NAME=smartcivic

# App URL (used in emails)
APP_BASE_URL=http://localhost:5000

# Email (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# AI Features
OPENWEATHER_API_KEY=your-openweathermap-api-key
AI_IMAGE_ANALYSIS_ENABLED=True
