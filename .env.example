# Copy this file to .env and fill in real values before starting the server.

# REQUIRED — strong random strings (e.g. openssl rand -hex 32)
SECRET_KEY=replace_with_a_long_random_string
JWT_SECRET=replace_with_a_different_long_random_string
ADMIN_INVITE_CODE=replace_with_a_unique_staff_invite_code
SEED_PASSWORD=replace_with_a_unique_seed_password_at_least_12_characters

# MongoDB connection URI (default works for local dev)
MONGO_URI=mongodb://127.0.0.1:27017/smartcivic

# Gemini API key — optional, AI falls back to rule-based without it
GEMINI_API_KEY=

# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# OSRM routing — default uses public demo server
OSRM_BASE=http://router.project-osrm.org
