# ── SmartCivic+ Environment Template ──────────────────────────────────────────
# Copy this file to `.env` and replace ALL placeholder values before starting
# the application.  The app REFUSES TO BOOT if any required value still contains
# the "replace_" marker, is empty, or is shorter than 16 characters.
#
# Generate random secrets with:
#     openssl rand -hex 32        # 64 hex chars (recommended for SECRET/JWT)
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUIRED — strong random strings (min 16 chars each, must be DIFFERENT) ──
SECRET_KEY=replace_with_a_long_random_string
JWT_SECRET=replace_with_a_different_long_random_string

# REQUIRED — admin/staff invitation code.  Without this no officer account can
# ever be created via the self-serve portal.
ADMIN_INVITE_CODE=replace_with_a_unique_staff_invite_code

# REQUIRED — used by scripts/seed_plus.py (only) when bootstrapping test users.
# This MUST be at least 12 characters long or seed_plus.py will abort.
SEED_PASSWORD=replace_with_a_unique_seed_password_at_least_12_characters

# ── MongoDB connection ────────────────────────────────────────────────────────
# Default works for a local MongoDB listening on the standard port.
# In PRODUCTION (FLASK_ENV=production) localhost URIs are rejected at boot.
MONGO_URI=mongodb://127.0.0.1:27017/smartcivic

# ── Optional AI / integrations ────────────────────────────────────────────────
# Gemini API key — if left blank, text/vision classification falls back to the
# built-in rule-based engine (no network calls are made).
GEMINI_API_KEY=

# ── Security flags ────────────────────────────────────────────────────────────
# Set to TRUE only when serving the app over HTTPS.  In PRODUCTION mode this
# is MANDATORY (the app will refuse to start if it's false).
COOKIE_SECURE=false

# ── Routing engine ────────────────────────────────────────────────────────────
# OSRM routing base URL.  Default uses the public Project OSRM demo server
# which is suitable for development only; deploy your own OSRM in production.
OSRM_BASE=http://router.project-osrm.org
ROUTING_ENGINE_URL=http://router.project-osrm.org/route/v1/driving/

# ── Runtime environment ───────────────────────────────────────────────────────
# Set to "production" to enable strict runtime checks:
#   * MONGO_URI may not point to localhost / 127.0.0.1
#   * COOKIE_SECURE must be true
# Leave unset or set to "development" for local work.
FLASK_ENV=development
